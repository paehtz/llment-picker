{
  "manifest_version": 3,
  "name": "LLMent Picker",
  "version": "1.5.3",
  "description": "Klick auf ein Seitenelement kopiert URL und eindeutigen CSS-Selektor, markierter Text kommt mit – für KI-Chats und Coding-Agenten.",
  "homepage_url": "https://github.com/paehtz/llment-picker",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "LLMent Picker (Alt+Shift+P)"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "LLMent Picker auf der aktuellen Seite starten / abbrechen"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
