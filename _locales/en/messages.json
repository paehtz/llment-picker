  "optSubfolderHint": {
    "message": "Extensions may only write to the browser's download folder. The subfolder is created there; leave empty to save directly into the download folder."
  },
  "optSaveAs": {
    "message": "Show a \"Save as\" dialog when saving"
  },
  "optSaveAsHint": {
    "message": "Off: the file is saved to the subfolder without asking and its path is added as the last clipboard line."
  },
  "optCss": {
    "message": "Include CSS context in the HTML file"
  },
  "optCssHint": {
    "message": "Effective layout values and the applied stylesheet rules for the element and its parent, as a comment above the markup. Not needed for portal content (tables, timetables)."
  },
  "optHideHints": {
    "message": "Hide key hints next to the outline"
  },
  "optHideHintsHint": {
    "message": "Default: the four hints (\"Ctrl HTML\", \"Alt Screenshot\", \"R Record\", \"Drag region\") stay next to the symbols whenever the element is wide enough for them; narrow elements show symbols only."
