{
  "manifest_version": 3,
  "name": "LLMent Picker",
  "version": "1.5.5",
  "description": "Klick auf ein Seitenelement kopiert URL und eindeutigen CSS-Selektor, markierter Text kommt mit – für KI-Chats und Coding-Agenten.",
  "author": "Henning Pähtz",
  "homepage_url": "https://github.com/paehtz/llment-picker",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "LLMent Picker (Strg+Alt+P)"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "menus",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+P"
      },
      "description": "LLMent Picker auf der aktuellen Seite starten / abbrechen"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "llment-picker@paehtz.de",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
